---
import { site, nav } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="f-brand"><img src="/brand/logo-light.png" alt="Le Moon Rooftop" width="287" height="91" loading="lazy" /></p>
      <p>{site.tagline}, on the rooftop of the Amanjaya Pancam Hotel by the Phnom Penh riverside.</p>
    </div>
    <div>
      <h2>Visit</h2>
      <p>{site.address.venue}<br />{site.address.street}<br />{site.address.locality}, Cambodia</p>
      <p>{site.hours.label}</p>
    </div>
    <div>
      <h2>Book</h2>
      <p>
        <a href={`tel:${site.phone.e164}`} data-track="click_phone">{site.phone.display}</a><br />
        <a href={site.telegram.url} data-track="click_telegram" rel="noopener">Telegram @{site.telegram.handle}</a><br />
        {site.email && <><a href={`mailto:${site.email}`} data-track="click_email">{site.email}</a><br /></>}
        <a href="/booking/">Book a table online</a>
      </p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      {site.social.length > 0 && (
        <p class="social">{site.social.map((s) => <a href={s.url} rel="noopener">{s.name}</a>)}</p>
      )}
    </div>
  </div>
  <div class="wrap legal">
    <p>© {year} {site.name}. <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); margin-top: 5rem; padding: 3.5rem 0 1.5rem; color: var(--muted); font-size: 0.95rem; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2rem; }
  h2 { font-family: var(--sans); font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin: 0 0 0.8rem; }
  .f-brand { margin: 0 0 1rem; }
  .f-brand img { height: 60px; width: auto; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { margin-bottom: 0.3rem; }
  a { color: var(--cream); }
  .social { display: flex; gap: 1rem; flex-wrap: wrap; }
  .legal { border-top: 1px solid var(--line); margin-top: 2.5rem; padding-top: 1.25rem; font-size: 0.85rem; }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .grid { grid-template-columns: 1fr; } }
</style>
