---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image?: ImageMetadata; alt?: string; }
const { image, alt = '' } = Astro.props;
---
<section class="hero">
  {image && <Image src={image} alt={alt} widths={[640, 1024, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" class="bg" />}
  <div class="shade"></div>
  <div class="wrap content"><slot /></div>
</section>
<style>
  .hero { position: relative; min-height: min(88vh, 820px); display: grid; align-items: end; overflow: hidden;
    background: radial-gradient(circle at 78% 22%, rgba(232, 207, 148, 0.35) 0 5%, transparent 5.5%), radial-gradient(ellipse at 50% 120%, #3a2b4a, var(--night) 65%); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 0%, transparent 55%, var(--night) 100%), linear-gradient(90deg, rgba(11, 16, 32, 0.7) 0%, rgba(11, 16, 32, 0.25) 50%, transparent 75%); }
  @media (max-width: 700px) { .shade { background: linear-gradient(180deg, transparent 0%, rgba(11, 16, 32, 0.35) 40%, var(--night) 100%); } }
  .content { position: relative; padding: 6rem 0 clamp(3rem, 8vw, 5.5rem); }
  .content :global(h1) { max-width: 14ch; }
  .content :global(.lead) { color: var(--cream); }
</style>
