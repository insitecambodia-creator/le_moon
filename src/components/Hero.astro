---
// Home hero: full-width photo, with the slot's <h1> drawn as a huge outline title
// sitting across the photo's bottom edge (style from the original Le Moon site).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image?: ImageMetadata; alt?: string; }
const { image, alt = '' } = Astro.props;
---
<section class="hero">
  <div class="photo">
    {image && <Image src={image} alt={alt} widths={[640, 1024, 1600, 2200]} sizes="100vw" loading="eager" fetchpriority="high" class="bg" />}
    <div class="shade"></div>
  </div>
  <div class="wrap content"><slot /></div>
</section>
<style>
  .hero { --title: clamp(3.6rem, 11.5vw, 10.5rem); position: relative; padding-bottom: clamp(3rem, 7vw, 5rem); text-align: center; }
  .photo { position: relative; height: min(68vh, 700px); min-height: 360px; overflow: hidden;
    background: radial-gradient(ellipse at 50% 120%, #22306a, var(--night) 65%); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11, 17, 39, 0.1) 0%, rgba(11, 17, 39, 0.25) 60%, rgba(11, 17, 39, 0.65) 100%); }
  .content { position: relative; margin-top: calc(var(--title) * -0.6); }
  .content :global(h1) {
    font-size: var(--title); line-height: 0.95; letter-spacing: 0.01em; margin: 0 0 0.35rem;
    color: transparent; -webkit-text-stroke: 1.5px var(--accent);
  }
  @supports not (-webkit-text-stroke: 1px black) { .content :global(h1) { color: var(--accent); } }
  .content :global(.tagline) { font-family: var(--display); text-transform: uppercase; letter-spacing: 0.03em; color: var(--link); font-size: clamp(1.25rem, 2.4vw, 2rem); line-height: 1.2; margin: 0 0 1.2rem; }
  .content :global(.lead) { color: var(--cream); margin-inline: auto; }
  .content :global(.btn-row) { justify-content: center; }
  @media (max-width: 600px) { .content :global(h1) { -webkit-text-stroke-width: 1.2px; } }
</style>
