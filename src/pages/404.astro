---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="This page is not on the Le Moon Rooftop website." noindex>
  <section class="page-hero">
    <div class="narrow">
      <span class="eyebrow">Page not found</span>
      <h1>This page has gone dark</h1>
      <p class="lead">The page you are looking for isn't here, perhaps it was a past event. The rooftop is still open every evening from 5pm.</p>
      <div class="btn-row" style="justify-content:center"><a class="btn btn-primary" href="/">Home</a><a class="btn" href="/menu/">Menu</a><a class="btn" href="/offers/">Offers</a><a class="btn" href="/booking/">Book a table</a></div>
    </div>
  </section>
</BaseLayout>
