---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingForm from '../../components/BookingForm.astro';
import { photo } from '../../lib/images';

const packages = [
  { value: 'option-1', name: 'Drink option 1', what: '2 hours of Tiger draft beer and soft drinks, free flow', price: '$16.00', extra: 'Additional hour $6.50' },
  { value: 'option-2', name: 'Drink option 2', what: '2 hours of Tiger draft beer, house wines (red and white) and soft drinks, free flow', price: '$25.00', extra: 'Additional hour $12.00' },
];
---
<BaseLayout
  title="Groups, team parties and social gatherings"
  description="Plan a team party or social gathering at Le Moon Rooftop in Phnom Penh: free-flow beer, wine and soft drink packages from $16 per guest for groups of 20 or more."
  image="/og/groups.jpg"
  breadcrumbs={[{ name: 'Groups', path: '/groups/' }]}
>
  <section class="page-hero">
    <div class="narrow">
      <span class="eyebrow">Social gatherings</span>
      <h1>Groups and team parties</h1>
      <p class="lead">Looking to organise a party for your team? Le Moon Rooftop has you covered.</p>
      <a class="btn btn-primary" href="#enquire">Send an enquiry</a>
    </div>
  </section>

  <section class="section" style="padding-top:1rem">
    <div class="wrap">
      <p class="center muted">For groups of at least 20 guests, for 2 hours. Prices are per guest and include 10% VAT.</p>
      <div class="cards">
        {packages.map((p) => (
          <div class="card">
            <span class="eyebrow">{p.name}</span>
            <p class="price">{p.price} <small>per guest</small></p>
            <p>{p.what}</p>
            <p class="muted">{p.extra}</p>
          </div>
        ))}
        <div class="card">
          <span class="eyebrow">Add-on</span>
          <p class="price">$65.00 <small>per jar</small></p>
          <p>Cocktail party jar: 3 litres, about 20 glasses.</p>
          <p class="muted">Food options available on request.</p>
        </div>
      </div>
      <p class="center"><a href="/menus/group-package.jpg">Download our group offer</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Your own corner of the rooftop</h2>
        <p class="muted">Sunset drinks after work, a company celebration or a get-together with friends: we set up the space, keep the drinks flowing and look after the details.</p>
      </div>
      <div class="media-frame">
        {photo('groups-hero') && <Image src={photo('groups-hero')!} alt="Guest raising a drink at the bar with cocktails at dusk" widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 50vw" />}
      </div>
    </div>
  </section>

  <section class="section" id="enquire">
    <div class="narrow">
      <h2 class="center">Send an enquiry</h2>
      <BookingForm type="groups" packages={packages.map((p) => ({ value: p.value, label: `${p.name}: ${p.price} per guest` }))} />
    </div>
  </section>
</BaseLayout>
<style>.price small { font-family: var(--sans); font-size: 0.9rem; color: var(--muted); }</style>
